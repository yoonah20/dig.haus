ANTHROPIC_API_KEY=your_key_here
LASTFM_API_KEY=your_key_here
DISCOGS_TOKEN=your_key_here
SPOTIFY_CLIENT_ID=your_key_here
SPOTIFY_CLIENT_SECRET=your_key_here
YOUTUBE_API_KEY=your_key_here
# Review URL discovery — engines selectable from the admin 자동 검색
# button (Serper / Tavily / Jina). Set the keys for the engines you want
# enabled; a missing key just disables that option. Jina search reuses
# JINA_API_KEY below (same account key as the r.jina.ai reader).
# DISCOVERY_ENGINE sets the default engine — used by the auto-curation
# batch and as the admin route fallback when no engine is picked.
# Defaults to tavily when unset (1000 searches/mo recurring free); set to
# serper or jina to flip.
DISCOVERY_ENGINE=tavily
SERPER_API_KEY=your_key_here
TAVILY_API_KEY=your_key_here

# Jina account key — powers both r.jina.ai (reader) and s.jina.ai (search).
# For the reader it's optional: without it the free anonymous reader still
# runs, but Cloudflare-challenged review pages can't be recovered and are
# dropped as bot-blocked; with it, those pages are retried through Jina's
# browser engine + residential proxy (token-billed, fires only on CF walls).
# For the Jina discovery engine (DISCOVERY_ENGINE=jina) it's required — the
# keyless search endpoint returns 403.
JINA_API_KEY=jina_xxxxxxxx

# LLM routing — every op runs through DeepSeek V4 Flash by default.
# Per-op overrides (LLM_PRIMARY_MODEL_<OP>, <OP> uppercased) win over any
# blanket LLM_PRIMARY_MODEL, so they flip a single op regardless of the
# global default. The quality-critical review path runs on V4 Pro: the
# extraction step picks the 2-sentence excerpt the summary synthesises,
# so both are promoted together (summary alone can't beat weak excerpts):
#   LLM_PRIMARY_MODEL_SCRAPE_REVIEW=deepseek-v4-pro
#   LLM_PRIMARY_MODEL_MANUAL_REVIEW=deepseek-v4-pro
#   LLM_PRIMARY_MODEL_SUMMARY_FALLBACK=deepseek-v4-pro
# Mechanical ops (similar_descriptions, serper_pick, pronunciation) stay on
# flash — Pro buys no quality there. To A/B before committing, use a shadow
# instead (primary stays flash, shadow shows up in /admin/compare):
#   LLM_SHADOW_MODEL_SUMMARY_FALLBACK=deepseek-v4-pro
# Pro requires DEEPSEEK_API_KEY below.
DEEPSEEK_API_KEY=your_key_here

PORT=3001
CLIENT_URL=http://localhost:3000

# Phase 2: Google OAuth login
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
SESSION_SECRET=your_random_long_secret_string

# Comma-separated list of admin email addresses (auto-promoted on login)
ADMIN_EMAILS=your@gmail.com

# Resend — 5-minute digest of new album-registration requests. Leave
# RESEND_API_KEY blank in dev to have the notifier skip sending (it will
# log a warning each tick but not crash).
RESEND_API_KEY=re_xxxxxxxxxx
ADMIN_NOTIFY_EMAIL=fpp@dig.haus
ADMIN_NOTIFY_FROM=notifications@dig.haus
