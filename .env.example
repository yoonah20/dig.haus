ANTHROPIC_API_KEY=your_key_here
LASTFM_API_KEY=your_key_here
DISCOGS_TOKEN=your_key_here
SPOTIFY_CLIENT_ID=your_key_here
SPOTIFY_CLIENT_SECRET=your_key_here
YOUTUBE_API_KEY=your_key_here
# Review URL discovery — three engines selectable from the admin
# 자동 검색 button (Serper / Tavily / Brave). Set the keys for the
# engines you want enabled; missing key just disables that option.
# Google CSE is a dormant fallback, key read by services/googleCse.ts
# when its import gets swapped into routes/albumReviews.ts.
SERPER_API_KEY=your_key_here
BRAVE_SEARCH_API_KEY=your_key_here
TAVILY_API_KEY=your_key_here
GOOGLE_CSE_API_KEY=your_key_here
GOOGLE_CSE_ID=your_cse_id_here

# Jina Reader premium key. Optional — without it the free anonymous reader
# still runs, but Cloudflare-challenged review pages can't be recovered and
# are dropped as bot-blocked. With it, those pages are retried through Jina's
# browser engine + residential proxy (token-billed, fires only on CF walls).
JINA_API_KEY=jina_xxxxxxxx

PORT=3001
CLIENT_URL=http://localhost:3000

# Phase 2: Google OAuth login
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
SESSION_SECRET=your_random_long_secret_string

# Comma-separated list of admin email addresses (auto-promoted on login)
ADMIN_EMAILS=your@gmail.com

# Resend — 5-minute digest of new album-registration requests. Leave
# RESEND_API_KEY blank in dev to have the notifier skip sending (it will
# log a warning each tick but not crash).
RESEND_API_KEY=re_xxxxxxxxxx
ADMIN_NOTIFY_EMAIL=fpp@dig.haus
ADMIN_NOTIFY_FROM=notifications@dig.haus
